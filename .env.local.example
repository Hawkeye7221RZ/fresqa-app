# Salin file ini jadi ".env.local", lalu isi dengan data dari Supabase Dashboard
# (Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-di-sini

# Token dari Fonnte (fonnte.com) buat kirim notifikasi WhatsApp.
# TANPA prefix NEXT_PUBLIC_ — ini rahasia, cuma dipakai di server,
# nggak boleh kebuka ke browser.
FONNTE_TOKEN=isi-token-fonnte-di-sini

# Midtrans (midtrans.com) buat payment gateway.
# Server Key & Service Role Key itu RAHASIA (jangan pakai prefix NEXT_PUBLIC_).
# Client Key aman dipakai di browser (makanya pakai prefix NEXT_PUBLIC_).
MIDTRANS_SERVER_KEY=isi-server-key-midtrans-sandbox
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=isi-client-key-midtrans-sandbox
MIDTRANS_IS_PRODUCTION=false

# Service Role Key Supabase — beda dari anon key di atas.
# Ambil dari Supabase Dashboard > Project Settings > API > service_role.
# Dipakai KHUSUS di webhook Midtrans, biar bisa update tabel orders
# tanpa kena batasan RLS (soalnya request-nya datang dari server
# Midtrans, bukan user yang login).
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini

# PENTING: jangan pernah commit file .env.local ke GitHub.
# File ini (.env.local.example) aman di-commit karena isinya cuma contoh.
